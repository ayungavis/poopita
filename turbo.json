{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["APP_STORE_ID"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "lint": {},
    "theme:check": {},
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

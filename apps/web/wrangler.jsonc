{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poopita-web",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "poopita.ayungavis.com", "custom_domain": true }],
}

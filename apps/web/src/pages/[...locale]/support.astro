---
import { APP_STORE_ID } from "astro:env/server";
import { SupportPage } from "../../components/SupportPage";
import { messagesFor } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeFromParam, localeStaticPaths } from "../../lib/routes";
import { seoFor } from "../../lib/seo";

export const getStaticPaths = localeStaticPaths;

const locale = localeFromParam(Astro.params.locale);
const messages = messagesFor(locale);
const seo = seoFor({
  locale,
  page: "support",
  meta: messages.support.meta,
  imageAlt: messages.landing.hero.iconAlt,
  appStoreId: APP_STORE_ID,
});
---

<BaseLayout seo={seo}>
  <SupportPage locale={locale} messages={messages} />
</BaseLayout>

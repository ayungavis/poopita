    "settings.guide.desc1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate hard lumps, like nuts. Hard to pass."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumpalan keras terpisah, seperti kacang. Sulit dikeluarkan."
          }
        }
      }
    },
    "settings.guide.desc2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sausage-shaped but lumpy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbentuk sosis tetapi bergumpal."
          }
        }
      }
    },
    "settings.guide.desc3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a sausage with cracks on the surface."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti sosis dengan retakan di permukaannya."
          }
        }
      }
    },
    "settings.guide.desc4" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like a sausage or snake, smooth and soft."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seperti sosis atau ular, halus dan lunak."
          }
        }
      }
    },
    "settings.guide.desc5" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft blobs with clear-cut edges. Easy to pass."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumpalan lunak dengan tepi jelas. Mudah dikeluarkan."
          }
        }
      }
    },
    "settings.guide.desc6" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluffy, mushy pieces with ragged edges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potongan lembek dengan tepi tidak rata."
          }
        }
      }
    },
    "settings.guide.desc7" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watery, no solid pieces."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cair, tanpa bagian padat."
          }
        }
      }

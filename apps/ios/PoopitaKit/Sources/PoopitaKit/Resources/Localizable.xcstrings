{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "error.badRequest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in this request was not valid."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada bagian permintaan yang tidak valid."
          }
        }
      }
    },
    "error.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was changed somewhere else. Refresh and try again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ini telah diubah di tempat lain. Muat ulang lalu coba lagi."
          }
        }
      }
    },
    "error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check your connection and try again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya Anda sedang offline. Periksa koneksi lalu coba lagi."
          }
        }
      }
    },
    "error.notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not find what you were looking for."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat menemukan yang Anda cari."
          }
        }
      }
    },
    "error.rateLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Please wait a moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak permintaan. Mohon tunggu sebentar."
          }
        }
      }
    },
    "error.serverRejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not process this request."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak dapat memproses permintaan ini."
          }
        }
      }
    },
    "error.sessionExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Anda telah berakhir. Silakan masuk kembali."
          }
        }
      }
    },
    "error.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is temporarily unavailable."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan sedang tidak tersedia untuk sementara."
          }
        }
      }
    },
    "error.unexpected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan. Silakan coba lagi."
          }
        }
      }
    },
    "home.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa lagi"
          }
        }
      }
    },
    "home.status.degraded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some services are having trouble."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa layanan sedang bermasalah."
          }
        }
      }
    },
    "home.status.healthy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All systems are running."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sistem berjalan."
          }
        }
      }
    },
    "home.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poopita"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Poopita"
          }
        }
      }
    }
  }
}

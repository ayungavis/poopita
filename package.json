{
  "name": "poopita",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "bun run format:check && turbo run lint typecheck theme:check test build",
    "deploy": "turbo run build && bun run --cwd apps/web deploy"
  },
  "devDependencies": {
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "turbo": "2.11.10"
  },
  "packageManager": "bun@1.3.10"
}
